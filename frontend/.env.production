# ค่าเฉพาะตอน `vite build` (mode=production) — Vite โหลดไฟล์นี้ทับ .env อัตโนมัติ ไม่ต้องสั่ง flag อะไรเพิ่ม
#
# ตอน prod ไม่มี Vite dev server มา proxy /api/checkin ให้เหมือนตอน dev แล้ว (ดู vite.config.js: server.proxy
# ใช้แค่ตอนรัน `vite dev` เท่านั้น) เลยต้องชี้ไปที่ router.php ของ backend จริงตรงๆ
#
# ใช้ query string ?path= แทน PATH_INFO (/GBG-MANAGEMENT/api/checkin/auth/login) เพราะ nginx บน prod ยังไม่ได้
# ตั้ง fastcgi_split_path_info ให้รองรับ PATH_INFO เลย (ดู core/autoload.php comment เรื่อง api/v1 ที่เจอปัญหา
# เดียวกันมาก่อนแล้วบน nginx จริง) — router.php เองรองรับ $_GET['path'] อยู่แล้วเป็นทางหลักที่ชัวร์สุด
VITE_API_BASE_URL=/checkin/backend/router.php?path=

VITE_USE_MOCK=false
VITE_SIMULATE_CHECKIN=false

# พื้นที่ที่อนุญาตให้ลงเวลา (geofence) — ตั้งค่าจริงให้ตรงกับสำนักงานก่อนใช้งานจริง (ค่านี้ก๊อปมาจาก .env
# เฉยๆ ไว้ก่อน ยังไม่ได้ปรับสำหรับ prod)
VITE_ENFORCE_GEOFENCE=false
VITE_OFFICE_LAT=13.7563
VITE_OFFICE_LNG=100.5018
VITE_OFFICE_RADIUS=200

# เข้าสู่ระบบด้วย Google (Google Identity Services) — Client ID จาก Google Cloud Console (public, ไม่ใช่
# secret ฝัง frontend ได้ปกติ) ปล่อยว่าง = ปุ่ม Google แสดงผลแต่กดแล้ว error "ยังไม่ได้ตั้งค่า"
VITE_GOOGLE_CLIENT_ID=
