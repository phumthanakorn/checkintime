VITE_API_BASE_URL=/api/checkin
# พื้นที่ที่อนุญาตให้ลงเวลา (geofence)
VITE_ENFORCE_GEOFENCE=false
VITE_OFFICE_LAT=13.7563
VITE_OFFICE_LNG=100.5018
VITE_OFFICE_RADIUS=200

# เข้าสู่ระบบด้วย Google (Google Identity Services) — Client ID จาก Google Cloud Console (public, ไม่ใช่
# secret ฝัง frontend ได้ปกติ) ปล่อยว่าง = ปุ่ม Google แสดงผลแต่กดแล้ว error "ยังไม่ได้ตั้งค่า"
VITE_GOOGLE_CLIENT_ID=
